# Copy to .env; never commit .env. Every key the app reads must be listed here with a safe default or a comment.
# Python (SQLAlchemy) uses postgresql+psycopg://…; Node (Prisma, Drizzle) uses postgresql://…
{{ENV_PREFIX}}_DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
{{ENV_PREFIX}}_LOG_LEVEL=INFO
